import LowerBounds.TropicSound

namespace SuperpermLowerBounds.Tropic.TropicN12
open SuperpermLowerBounds.Tropic
local notation "sel(" c ", " a ", " b ")" => @Bool.rec (fun _ => _) b a c

private noncomputable def symInfo_c0 : Nat := 
noncomputable def get_symInfo (i : Nat) : Nat := Nat.mod (Nat.div symInfo_c0 (Nat.pow 4096 i)) 4096

private noncomputable def symId_c0 : Nat := 
noncomputable def get_symId (i : Nat) : Nat := Nat.mod (Nat.div symId_c0 (Nat.pow 4096 i)) 4096

private noncomputable def d1State_c0 : Nat := 
noncomputable def get_d1State (i : Nat) : Nat := Nat.mod (Nat.div d1State_c0 (Nat.pow 65536 i)) 65536

private noncomputable def maxPsi0_c0 : Nat := 
noncomputable def get_maxPsi0 (i : Nat) : Nat := Nat.mod (Nat.div maxPsi0_c0 (Nat.pow 4294967296 i)) 4294967296

private noncomputable def maxPsi1_c0 : Nat := 
noncomputable def get_maxPsi1 (i : Nat) : Nat := Nat.mod (Nat.div maxPsi1_c0 (Nat.pow 4294967296 i)) 4294967296

private noncomputable def maxPsi2_c0 : Nat := 
noncomputable def get_maxPsi2 (i : Nat) : Nat := Nat.mod (Nat.div maxPsi2_c0 (Nat.pow 4294967296 i)) 4294967296

private noncomputable def pairMode_c0 : Nat := 
private noncomputable def pairMode_c1 : Nat := 
private noncomputable def pairMode_c2 : Nat := 
private noncomputable def pairMode_c3 : Nat := 
private noncomputable def pairMode_c4 : Nat := 0x5555540000050000000000000000000000000000000000000000000000000
private noncomputable def pairMode_chk (c : Nat) : Nat := sel(Nat.ble 2 c, sel(Nat.ble 3 c, sel(Nat.ble 4 c, pairMode_c4, pairMode_c3), pairMode_c2), sel(Nat.ble 1 c, pairMode_c1, pairMode_c0))
noncomputable def get_pairMode (i : Nat) : Nat := Nat.mod (Nat.div (pairMode_chk (Nat.div i 4096)) (Nat.pow 4 (Nat.mod i 4096))) 4

noncomputable def get_ovList (s : Nat) : List Nat := sel(Nat.beq s 101, [114], sel(Nat.beq s 114, [101, 114], []))

end SuperpermLowerBounds.Tropic.TropicN12
